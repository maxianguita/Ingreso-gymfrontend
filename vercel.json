{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ingresos-gym-back.onrender.com/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://ingresos-gym-back.onrender.com/auth/:path*"
    },
    {
      "source": "/admin/expiring",
      "destination": "https://ingresos-gym-back.onrender.com/admin/expiring"
    },
    {
      "source": "/admin/notify-expiring",
      "destination": "https://ingresos-gym-back.onrender.com/admin/notify-expiring"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
